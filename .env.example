# URL pública do sistema (usada nos links do WhatsApp e no QR da portaria)
APP_URL=http://localhost:3000

# Conexão direta com o Postgres do Supabase da VPS (use o pooler na porta 6543 em produção).
# Sem esta variável, o sistema roda com um Postgres embutido (PGlite) em .data/ — bom para dev e demo.
# Para os scripts (db:migrate, db:seed), crie um arquivo por ambiente, ex.: .env.producao.local, e rode com ENV_FILE=.env.producao.local
# DATABASE_URL=postgres://USUARIO:SENHA@db.suaempresa.com.br:5432/integra?sslmode=require

# Segredo para assinar a sessão do painel (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=troque-este-segredo-em-producao

# Modo demo: mostra botões de entrada rápida no login e semeia dados fictícios no banco embutido.
DEMO_MODE=true
